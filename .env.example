# Server
HOST=0.0.0.0
PORT=3000

# Modbus – Pressure gauges (RS485→Ethernet gateways)
PRESSURE_PRODUCTION_IP=192.168.0.8
PRESSURE_PRODUCTION_UNIT=1
PRESSURE_ASSEMBLY_IP=192.168.0.17
PRESSURE_ASSEMBLY_UNIT=2
PRESSURE_PORT=502
PRESSURE_REGISTER=0
PRESSURE_POLL_INTERVAL=2.0

# Modbus – FY600 Water tank controller
FY600_IP=192.168.0.16
FY600_UNIT=1
FY600_PORT=502
FY600_POLL_INTERVAL=2.0

# Storage – prevent disk fill
# Keep raw samples this many days, then delete
RETENTION_DAYS=14
# Max rows returned by history APIs (safety)
HISTORY_MAX_ROWS=5000
# How often to run cleanup (hours)
CLEANUP_INTERVAL_HOURS=6

# SQLite path (relative to working dir or absolute)
DATABASE_PATH=./data/modbus.db

# Multi-device FY600 registry; register addresses require device-manual confirmation.
FY600_DEVICES='[{"name":"pump_house_tank","tank_id":"pump_house_tank","ip":"192.168.0.16","port":502,"unit":1,"level_register":138,"setpoint_register":0,"output_register":135,"level_scale":10.0,"setpoint_scale":10.0,"output_scale":10.0,"timeout":2.0,"retries":2,"retry_delay":0.2,"reconnect_delay":3.0,"stale_after_seconds":30,"enabled":true},{"name":"main_tank","tank_id":"main_tank","ip":"192.168.0.18","port":502,"unit":1,"level_register":138,"setpoint_register":0,"output_register":135,"level_scale":10.0,"setpoint_scale":10.0,"output_scale":10.0,"timeout":2.0,"retries":2,"retry_delay":0.2,"reconnect_delay":3.0,"stale_after_seconds":30,"enabled":true}]'
